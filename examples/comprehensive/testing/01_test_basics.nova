// Example 1: Test Basics
// Demonstrates: unit tests, integration tests, test organization, assertions

fn main() {
    println!("=== Test Basics ===\n")

    // ===== UNIT TESTS =====
    println!("--- Unit Tests ---")

    #[test]
    fn test_addition() {
        assert_eq!(2 + 2, 4)
    }

    #[test]
    fn test_subtraction() {
        assert_eq!(10 - 3, 7)
    }

    #[test]
    fn test_multiplication() {
        assert_eq!(6 * 7, 42)
    }

    #[test]
    fn test_division() {
        assert_eq!(20 / 4, 5)
    }

    // ===== ASSERTION MACROS =====
    println!("\n--- Assertion Macros ---")

    #[test]
    fn test_assertions() {
        // Equality
        assert_eq!(1 + 1, 2)
        assert_ne!(1 + 1, 3)

        // Boolean
        assert!(true)
        assert!(!false)

        // Comparison
        assert!(5 > 3)
        assert!(3 <= 5)

        // Custom message
        assert_eq!(2 + 2, 4, "Basic arithmetic failed")

        // Panic
        // assert!(false, "This will panic")
    }

    // ===== FLOAT COMPARISONS =====
    println!("\n--- Float Comparisons ---")

    #[test]
    fn test_float_equality() {
        let a = 0.1 + 0.2
        let b = 0.3
        // Use approx equality
        assert!((a - b).abs() < f64::EPSILON)

        // Or use float-cmp crate
        // assert_approx_eq!(a, b)
    }

    // ===== TESTING PANICS =====
    println!("\n--- Testing Panics ---")

    #[test]
    #[should_panic(expected = "division by zero")]
    fn test_divide_by_zero() {
        let _ = 10 / 0
    }

    #[test]
    #[should_panic]
    fn test_panic_any() {
        panic!("Something went wrong")
    }

    // ===== TEST SETUP/TEARDOWN =====
    println!("\n--- Test Setup/Teardown ---")

    // Using constructor/destructor pattern
    struct TestFixture {
        data: Vec<i32>,
    }

    impl TestFixture {
        fn new() -> Self {
            println!("  Setup: Creating fixture")
            TestFixture { data: vec![1, 2, 3] }
        }
    }

    impl Drop for TestFixture {
        fn drop(&mut self) {
            println!("  Teardown: Dropping fixture")
        }
    }

    #[test]
    fn test_with_fixture() {
        let fixture = TestFixture::new()
        assert_eq!(fixture.data.len(), 3)
    }

    // ===== PARAMETERIZED TESTS =====
    println!("\n--- Parameterized Tests ---")

    // Using data-driven approach
    struct TestCase {
        input: i32,
        expected: i32,
    }

    const TEST_CASES: &[TestCase] = &[
        TestCase { input: 0, expected: 0 },
        TestCase { input: 1, expected: 1 },
        TestCase { input: 2, expected: 4 },
        TestCase { input: 3, expected: 9 },
    ]

    #[test]
    fn test_square() {
        for case in TEST_CASES {
            assert_eq!(case.input * case.input, case.expected, "input: {}", case.input)
        }
    }

    // ===== INTEGRATION TESTS =====
    println!("\n--- Integration Tests ---")

    // In tests/integration_test.nova:
    // use my_crate::*;
    //
    // #[test]
    // fn test_full_workflow() {
    //     let mut app = App::new()
    //     app.run()
    //     assert!(app.is_healthy())
    // }

    println!("  Integration tests in tests/ directory")

    // ===== DOC TESTS =====
    println!("\n--- Doc Tests ---")

    /// Adds two numbers.
    /// 
    /// ```
    /// let sum = my_crate::add(2, 3);
    /// assert_eq!(sum, 5);
    /// ```
    fn add(a: i32, b: i32) -> i32 {
        a + b
    }

    // Doc tests run automatically with `nova test --doc`

    // ===== ASYNC TESTS =====
    println!("\n--- Async Tests ---")

    #[test]
    async fn test_async() {
        let result = async_function().await
        assert_eq!(result, 42)
    }

    async fn async_function() -> i32 {
        42
    }

    // ===== TEST MODULES =====
    println!("\n--- Test Modules ---")

    #[cfg(test)]
    mod tests {
        use super::*

        #[test]
        fn internal_test() {
            assert_eq!(add(1, 2), 3)
        }

        #[test]
        fn another_test() {
            assert!(true)
        }

        // Nested test modules
        mod nested {
            #[test]
            fn nested_test() {
                assert_eq!(2 * 3, 6)
            }
        }
    }

    // ===== TEST UTILITIES =====
    println!("\n--- Test Utilities ---")

    // Test-only helpers
    #[cfg(test)]
    fn create_test_data() -> Vec<i32> {
        vec![1, 2, 3, 4, 5]
    }

    #[test]
    fn test_with_helper() {
        let data = create_test_data()
        assert_eq!(data.len(), 5)
    }

    // ===== MOCKING =====
    println!("\n--- Mocking ---")

    // Using mockall or similar
    // #[automock]
    // trait Database {
    //     fn get_user(&self, id: u64) -> Result<User, Error>;
    // }
    //
    // #[test]
    // fn test_with_mock() {
    //     let mut mock = MockDatabase::new()
    //     mock.expect_get_user()
    //         .with(eq(1))
    //         .returning(|| Ok(User::new()));
    // }

    println!("  Mocking pattern shown")

    // ===== PROPERTY-BASED TESTING =====
    println!("\n--- Property-Based Testing ---")

    // Using proptest
    // proptest! {
    //     #[test]
    //     fn test_addition_commutative(a in 0..1000i32, b in 0..1000i32) {
    //         assert_eq!(a + b, b + a)
    //     }
    // }

    println!("  Property-based testing shown")

    // ===== TEST ORGANIZATION =====
    println!("\n--- Test Organization ---")
    println!("  Project structure:")
    println!("  src/")
    println!("    lib.nova          # Unit tests in #[cfg(test)] modules")
    println!("  tests/")
    println!("    integration.nova  # Integration tests")
    println!("    api.nova          # API tests")
    println!("  benches/")
    println!("    bench.nova        # Benchmarks")

    println!("\n✅ Test Basics example completed!")
}