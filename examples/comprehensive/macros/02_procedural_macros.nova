// Example 2: Procedural Macros
// Demonstrates: derive macros, attribute macros, function-like macros, syn/quote

fn main() {
    println!("=== Procedural Macros ===\n")

    // ===== DERIVE MACROS =====
    println!("--- Derive Macros ---")

    // In real implementation, this would be in a separate proc-macro crate:
    //
    // // Cargo.toml
    // [lib]
    // proc-macro = true
